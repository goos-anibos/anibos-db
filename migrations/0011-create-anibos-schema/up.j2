--
-- PostgreSQL Create anibos Schema
--

-- June 29, 2026 --

CREATE SCHEMA IF NOT EXISTS anibos;

CREATE ROLE anibos WITH LOGIN PASSWORD 'anibospass';
CREATE ROLE anibos_dev;
CREATE ROLE anibos_owners;
CREATE ROLE anibos_users;

GRANT ALL PRIVILEGES ON SCHEMA anibos TO anibos;
GRANT ALL PRIVILEGES ON SCHEMA anibos TO anibos_dev;
GRANT ALL PRIVILEGES ON SCHEMA anibos TO anibos_owners;
GRANT USAGE ON SCHEMA anibos TO anibos_users;


-- 1. Master tables

-- ------------------------------------------------------------------
-- 1.1 Create the countries table
-- ------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS anibos.countries (
    country_id      CHAR(2) PRIMARY KEY,      -- ISO 3166-1 alpha-2
    country_name    VARCHAR(100) NOT NULL,
    iso3_code       CHAR(3),                  -- ISO 3166-1 alpha-3
    iso_numeric     CHAR(3)                   -- ISO 3166-1 numeric code
);

