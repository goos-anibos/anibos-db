-- ------------------------------------------------------------------
-- 1.2 Create the institution_codes table. Dumpfile will populated contents from OTN mstr_institution_codes.
-- ------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS anibos.institution_codes (
    institutioncode     VARCHAR(200) PRIMARY KEY,
    institutionname     TEXT,
    website             TEXT,
    org_id              TEXT,
    country_id          CHAR(2) REFERENCES anibos.countries(country_id),
    state               TEXT,
    sector              TEXT,
    date_created          TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_updated          TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_sector CHECK (sector IN ('Government / Other public', 'Non-profit', 'Private', 'University, College, Research Hospital', 'Unknown'))
);


-- ------------------------------------------------------------------
-- 1.4 Create the contacts table. Dumpfile will populated contents from OTN mstr_contacts.
-- Frontend should to insert contact_pk as: lower('anibos_node_name') || nextval('anibos.contact_seq')::text
-- ------------------------------------------------------------------
CREATE SEQUENCE IF NOT EXISTS anibos.contact_seq START 1;
CREATE TABLE IF NOT EXISTS anibos.contacts (
	contact_pk text NOT NULL,
	first_name text NOT NULL,
	last_name text NOT NULL,
	email text NOT NULL,
	institution_code varchar(200) NOT NULL,
	country_id bpchar(2) NOT NULL,
	personal_url text NULL,
	is_active bool DEFAULT true,
	date_created timestamptz DEFAULT CURRENT_TIMESTAMP NOT NULL,
	date_updated timestamptz DEFAULT CURRENT_TIMESTAMP NOT NULL,
	CONSTRAINT chk_personal_url CHECK (((personal_url IS NULL) OR (personal_url ~~ 'https://%'::text))),
	CONSTRAINT contacts_email_unique UNIQUE (email),
	CONSTRAINT contacts_pkey PRIMARY KEY (contact_pk)
);
-- anibos.contacts foreign keys
ALTER TABLE anibos.contacts ADD CONSTRAINT contacts_country_id_fkey FOREIGN KEY (country_id) REFERENCES anibos.countries(country_id);
ALTER TABLE anibos.contacts ADD CONSTRAINT contacts_institution_code_fkey FOREIGN KEY (institution_code) REFERENCES anibos.institution_codes(institutioncode);


-- 2. Projects, campaigns and deployments tables
-- Each project may contain multiple campaigns; Each campaign (by the same vendor) contains multiple deployments (tag - platform/animal associations).
-- ------------------------------------------------------------------
-- 2.1 Create the projects table: dataset level attributes
-- ------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS anibos.projects (
    program                 TEXT NOT NULL,   -- e.g., AniBOS ATN, AniBOS IMOS, AniBOS OTN, AniBOS SMRU
    project_id              TEXT PRIMARY KEY,
    title                   TEXT NOT NULL,
    license                 TEXT NOT NULL,
    gts_ingest              BOOLEAN NOT NULL DEFAULT FALSE, -- Global attribute that indicates if the data provider intends this to published on the GTS
    project_name            TEXT,                   -- The name of the project(s) principally responsible for originating this data. Multiple projects can be separated by commas, as described under Attribute Content Guidelines. 
    uuid                    TEXT,                   -- Universally Unique Indentifier, 36 character string containing numbers, letters and dashes
    info_url                TEXT,                   -- URL for background information about this dataset. 
    summary                 TEXT,
    citation                TEXT,                   -- Murray, Kimberly; Hatch, Joshua; DiGiovanni, Robert. (2021). Gray seal (Halichoerus grypus) location data from a sateliite telemetry tag (ptt id 195533) deployed in the North Atlantic Ocean from 2020-01-30 to 2020-06-15, deployment id 5e32f4e46321be14905ea848. [Dataset]. US Integreated Ocean Observing System (IOOS) Animal Telemetry Network (ATN).
    keywords                TEXT,
    keywords_vocabulary     TEXT,
    history                 TEXT,
    publisher_type          TEXT,
    publisher_institutioncode_pk    TEXT REFERENCES anibos.institution_codes(institutioncode),
    publisher_contact_pk    TEXT REFERENCES anibos.contacts(contact_pk),
    date_created            TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_issued             TIMESTAMPTZ,
    date_modified           TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    is_active               BOOLEAN DEFAULT TRUE,
    CONSTRAINT publisher_type_check CHECK (
        publisher_type IN ('person', 'group', 'institution', 'position')
        )
);
-- ------------------------------------------------------------------
-- 2.2 Create the project_contributors junction table
-- ------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS anibos.contacts_projects (
    project_id       TEXT NOT NULL,
    contact_pk       TEXT NOT NULL,
    role             TEXT,
    role_type        TEXT NOT NULL,
    role_vocabulary  TEXT,
    start_date       DATE,
    end_date         DATE,
    is_creator       BOOLEAN DEFAULT FALSE,
    is_active        BOOLEAN DEFAULT TRUE,
    date_created       TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_updated       TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    -- Composite PK
    CONSTRAINT contacts_projects_pkey PRIMARY KEY (project_id, contact_pk),
    -- Date range check
    CONSTRAINT contacts_projects_dates_ck CHECK (
        (end_date IS NULL) OR (start_date <= end_date)
    )
);

-- ------------------------------------------------------------------
-- 2.3 Create the animals table
-- ------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS anibos.animals (
	animal_id text NOT NULL,
	scientific_name varchar NOT NULL,
	common_name varchar,
	aphia_id varchar,
	date_created timestamptz DEFAULT CURRENT_TIMESTAMP NOT NULL,
	date_updated timestamptz DEFAULT CURRENT_TIMESTAMP NOT NULL,
	"comment" text NULL,
	CONSTRAINT animals_pkey PRIMARY KEY (animal_id)
);

-- ------------------------------------------------------------------
-- 2.4 Create the campaigns table:
-- Each project_id and campaign have multiple deployments.
-- Deployments in one campaign share the same data provider (SMRU or WILDLIFECOMPUTERS), source, processing_level, qc_manual etc.
-- ------------------------------------------------------------------

CREATE TABLE IF NOT EXISTS anibos.campaigns (
    project_id               TEXT NOT NULL,   -- An identifier for the dataset, provided by and unique within its naming authority. The combination of the "naming authority" and the "id" should be globally unique, but the id can be globally unique by itself also. IDs can be URLs, URNs, DOIs, meaningful text strings, a local key, or any other unique string of characters. The id should not include white space characters.
    naming_authority         TEXT NOT NULL,
    argos_program_number     TEXT,
    instrument_manufacturer  TEXT NOT NULL,
    conventions              TEXT NOT NULL,
    sea_name                 TEXT NOT NULL,
    standard_name_vocab      TEXT NOT NULL,
    instrument               TEXT NOT NULL DEFAULT 'satellite telemetry tag',
    cdm_data_type            TEXT NOT NULL,
    feature_type             TEXT NOT NULL,
    data_mode                TEXT NOT NULL CHECK (data_mode IN ('real-time', 'near real-time', 'delayed-mode')),
    processing_level         TEXT NOT NULL,
    source                   TEXT NOT NULL,
    qc_manual                TEXT,
    date_issued              TIMESTAMPTZ,
    -- Housekeeping
    date_created               TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_updated               TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    -- Composite primary key
    CONSTRAINT campaigns_pkey PRIMARY KEY (project_id, campaign),
    CONSTRAINT deployments_sea_name_ck CHECK (
    sea_name IN (
        'ARCTIC', 'E INDIAN', 'GLOBAL', 'GREAT LAKES', 'MEDITERRANEAN',
        'MID PACIFIC', 'NE ATLANTIC', 'NE PACIFIC', 'NW ATLANTIC',
        'NW PACIFIC', 'SE ATLANTIC', 'SE PACIFIC', 'SOUTHERN',
        'SW ATLANTIC', 'SW PACIFIC', 'W INDIAN'
        )
    ),
    -- Foreign key to projects
    CONSTRAINT campaigns_project_id_fkey FOREIGN KEY (project_id)
        REFERENCES anibos.projects(project_id)
);


-- ------------------------------------------------------------------
-- 2.5 Create the deployments table
-- ------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS anibos.deployments (
    program                 TEXT NOT NULL,
    project_id              TEXT NOT NULL,
    campaign_id             TEXT,                    -- For SMRU e.g. ct123
    deployment_id           TEXT PRIMARY KEY,        -- e.g., '5e32f4e46321be14905ea848'
    animal_id               TEXT NOT NULL,
    wigos_station_identifier TEXT,
    wmo_platform_code       TEXT,
    deployment_lat          NUMERIC NOT NULL,
    deployment_lon          NUMERIC NOT NULL,
    deployment_start        TIMESTAMPTZ NOT NULL,
    deployment_end          TIMESTAMPTZ,
    manufacturer_id         TEXT,    -- vendor-assigned unique ID
    instrument              TEXT NOT NULL DEFAULT 'satellite telemetry tag',
    instrument_model        TEXT NOT NULL,
    instrument_ptt_id       TEXT NOT NULL,
    instrument_sensor_type  TEXT NOT NULL,          -- comma-separated list
    instrument_serial_number TEXT NOT NULL,
    platform                TEXT NOT NULL DEFAULT 'tagged animal',
    platform_id             TEXT,                   -- e.g., '137080'
    platform_name           TEXT NOT NULL,
    platform_type           TEXT NOT NULL,
    platform_vocabulary     TEXT NOT NULL,
    time_coverage_start     TIMESTAMPTZ,
    time_coverage_end       TIMESTAMPTZ,
    -- Geospatial extents
    geospatial_lat_min      NUMERIC NOT NULL DEFAULT 0.0,
    geospatial_lat_max      NUMERIC NOT NULL DEFAULT 0.0,
    geospatial_lat_units    TEXT NOT NULL DEFAULT 'degrees_north',
    geospatial_lon_min      NUMERIC NOT NULL DEFAULT 0.0,
    geospatial_lon_max      NUMERIC NOT NULL DEFAULT 0.0,
    geospatial_lon_units    TEXT NOT NULL DEFAULT 'degrees_east',
    geospatial_vertical_min NUMERIC NOT NULL DEFAULT 0.0,
    geospatial_vertical_max NUMERIC NOT NULL DEFAULT 0.0,
    geospatial_vertical_units TEXT NOT NULL DEFAULT 'm',
    geospatial_vertical_positive TEXT NOT NULL DEFAULT 'down' CHECK (geospatial_vertical_positive IN ('up', 'down')),
    geospatial_bounds       geometry(Polygon, 4326),   -- PostGIS geometry (WGS 84)
    geospatial_bounds_crs   TEXT DEFAULT 'EPSG:4326',
    geospatial_bounds_vertical_crs TEXT DEFAULT 'EPSG:5831',
    date_created              TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    date_updated              TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    -- Constraints
    CONSTRAINT deployments_dates_ck CHECK (deployment_start <= time_coverage_start),
    CONSTRAINT deployments_end_ck CHECK (
        (deployment_end IS NULL) OR (deployment_end >= time_coverage_end)
    ),
    CONSTRAINT lat_bounds_ck CHECK (
        geospatial_lat_min >= -90 AND
        geospatial_lat_max <= 90 AND
        geospatial_lat_min <= geospatial_lat_max
    ),
    CONSTRAINT lon_bounds_ck CHECK (
        geospatial_lon_min >= -180 AND
        geospatial_lon_max <= 180 AND
        geospatial_lon_min <= geospatial_lon_max
    ),
    CONSTRAINT vertical_bounds_ck CHECK (
        geospatial_vertical_min <= geospatial_vertical_max
    ),
    -- Foreign keys
    CONSTRAINT fk_deployments_animals FOREIGN KEY (animal_id) REFERENCES anibos.animals(animal_id),
    CONSTRAINT fk_deployments_campaign FOREIGN KEY (project_id, campaign) REFERENCES anibos.campaigns(project_id, campaign)
);