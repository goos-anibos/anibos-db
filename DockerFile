# Use the official TimescaleDB image (Alpine-based, includes PostGIS)
FROM ngosang/timescaledb-postgis:2.13.0-pg14-postgis3.4 AS database

# Set locale via environment variables (no need to generate)
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8

# Install required system packages using Alpine's apk
RUN apk add --no-cache git curl python3 python3-dev
RUN apk add --no-cache py3-pip libc-dev
RUN apk add --no-cache build-base postgresql-dev

# Install uv (as you wanted)
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_UNMANAGED_INSTALL="/opt/uv" sh

# Create and set up the virtual environment
WORKDIR /opt
RUN mkdir /opt/venv && chown postgres:postgres /opt/venv

USER postgres

# Copy requirements and install Python packages
COPY requirements.txt /requirements.txt
# Create venv using the system Python 3.11
RUN /opt/uv/uv venv /opt/venv/
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install pip, setuptools, wheel, and your dependencies
RUN /opt/uv/uv pip install pip
# Install setuptools and wheel
RUN pip install --no-cache-dir "setuptools==44" "wheel"
# Install opster for python 3.11
RUN pip install --no-cache-dir "opster>=4.5.1"
RUN pip install -r /requirements.txt

# Copy migrations and init scripts
USER root
COPY migrations/ /migrations
WORKDIR /migrations
RUN chmod o+w /migrations/nomad.ini

ENV INIT_DIR /docker-entrypoint-initdb.d
COPY --chmod=755 bootstrap.sh $INIT_DIR/
RUN chmod +x $INIT_DIR/bootstrap.sh && \
    sed -i 's/\r$//' $INIT_DIR/bootstrap.sh   # Fix Windows line endings
RUN ls -la $INIT_DIR/bootstrap.sh

COPY --chmod=755 bootstrap.sh $INIT_DIR
COPY pg_hba.conf* /pg_hba.conf
COPY postgresql.conf* /postgresql.conf

#ENV PGDATA /pg/data
#RUN mkdir -p $PGDATA && chown postgres:postgres $PGDATA

# Switch back to the default postgres user
USER postgres

EXPOSE 5432
